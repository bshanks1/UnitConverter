@page "{ConversionType?}/{Input?}"
@model UnitConverter.Pages.ConversionsModel

<!DOCTYPE html>

<html>
<head>
    <title>@ViewData["Title"]</title>
</head>

<body>
@if (ViewData["ErrorMessage"] != null)
{
    <p>@ViewData["Error Message"]</p>
}

else
{
    <div id="Conversion">
        <h1>@ViewData["ConversionType"]</h1>

        <p>Input: @Model.Input</p>
        <p>Output: @Model.Output</p>
    </div>
}
</body>
</html>
